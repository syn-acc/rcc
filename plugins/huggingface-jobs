#!/usr/bin/env python3
"""Hugging Face Jobs provider. Online operations use huggingface_hub==2.4.0."""

import json
import re
from urllib.parse import urlsplit

from _managed_job import Problem, credential, identifier, params_for, serve, token_name


STATES = {"SCHEDULING": "running", "RUNNING": "running", "COMPLETED": "done",
          "CANCELED": "failed", "ERROR": "failed", "DELETED": "failed"}


def settings(config):
    namespace = identifier(config.get("namespace"), "Hugging Face namespace")
    flavor = identifier(config.get("flavor"), "Jobs flavor")
    token_name(config, "HF_TOKEN")
    image, command, timeout = config.get("image"), config.get("command"), config.get("timeout_seconds")
    if not isinstance(image, str) or not re.fullmatch(r"[a-z0-9][\w./:-]*@sha256:[a-f0-9]{64}", image, re.ASCII):
        raise Problem("image must be a container reference pinned with @sha256:<digest>")
    if not isinstance(command, list) or not command or not all(isinstance(arg, str) and "\0" not in arg for arg in command) or not command[0]:
        raise Problem("command must be a fixed command argument array")
    if type(timeout) is not int or timeout < 1:
        raise Problem("timeout_seconds must be a positive integer")
    artifact = config.get("artifact_url_template")
    if artifact is not None:
        if not isinstance(artifact, str) or "{id}" not in artifact or re.search(r"[{}]", artifact.replace("{id}", "")):
            raise Problem("artifact_url_template must include the literal {id} placeholder")
        target = urlsplit(artifact)
        if target.scheme != "https" or not target.hostname or target.username or target.password or "{id}" in target.netloc:
            raise Problem("artifact_url_template must use a fixed HTTPS host without credentials")
    return namespace, flavor, image, command, timeout, artifact


def client(token):
    try:
        import httpx2
        from huggingface_hub import HfApi, set_client_factory
    except ImportError:
        raise Problem("install huggingface_hub==2.4.0 in the provider Python environment")
    set_client_factory(lambda: httpx2.Client(transport=httpx2.HTTPTransport(retries=0),
                                             follow_redirects=False, timeout=15,
                                             event_hooks={"response": [httpx2.Response.raise_for_status]}))
    return HfApi(endpoint="https://huggingface.co", token=token)


def handle(request):
    config, action = request["config"], request["action"]
    namespace, flavor, image, command, timeout, artifact = settings(config)
    if action == "status":
        return {"ok": True, "description": {"workload": "managed-job", "flavor": flavor,
                "what": "Run the configured Jobs image with params in the RCC_PARAMS_JSON environment variable.",
                "timeout_seconds": timeout, "check": "local configuration"}}
    if action in ("plan", "run"):
        params = params_for(request)
        if action == "plan":
            return {"ok": True, "dry": True, "params": params}
    else:
        run_id = identifier(request.get("id"), "Hugging Face job ID")
    api = client(credential(config, "HF_TOKEN"))
    try:
        if action == "run":
            job = api.run_job(namespace=namespace, image=image, command=command, flavor=flavor,
                              env={"RCC_PARAMS_JSON": json.dumps(params, allow_nan=False)}, timeout=timeout,
                              attempts=1)
        else:
            job = api.inspect_job(namespace=namespace, job_id=run_id)
    except Exception as exc:
        # SDK exceptions can carry headers or user-supplied payloads. Report only the HTTP code.
        code = getattr(getattr(exc, "response", None), "status_code", None)
        uncertain = code is None or code == 408 or code >= 500 or 300 <= code < 400
        raise Problem(f"Hugging Face Jobs returned HTTP {code}" if code else "Hugging Face Jobs request failed",
                      action == "run" and uncertain)
    try:
        run_id = identifier(job.id, "Hugging Face job ID")
        if action == "result" and run_id != request["id"]:
            raise Problem("Hugging Face returned a different job ID")
        stage = job.status.stage
        stride = {"id": run_id, "status": STATES[stage], "provider_status": stage,
                  "result_ref": f"https://huggingface.co/jobs/{namespace}/{run_id}"}
    except (KeyError, TypeError, AttributeError, Problem):
        raise Problem("Hugging Face Jobs returned an invalid job receipt", action == "run")
    if artifact and stride["status"] == "done":
        stride["artifact_ref"] = artifact.replace("{id}", run_id)
    return {"ok": True, "stride": stride}


if __name__ == "__main__":
    raise SystemExit(serve(handle))
